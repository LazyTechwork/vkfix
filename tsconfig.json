{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "sourceMap": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["vitest/globals"]
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vitest.setup.ts",
    "vitest.config.ts"
  ]
}
