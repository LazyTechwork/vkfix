{
  "name": "vkfix",
  "version": "2.1",
  "description": "VKFix Userscript for fixing VK social network",
  "private": true,
  "scripts": {
    "build": "vite build --mode production",
    "start": "vite build --watch --mode development",
    "dev": "vite",
    "type-check": "tsc --noEmit && vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": {
    "name": "Ivan Petrov",
    "email": "lazytechwork@gmail.com"
  },
  "contributors": [
    {
      "name": "Ivan Mel",
      "url": "https://github.com/ivanmem"
    }
  ],
  "repository": "github:lazytechwork/vkfix",
  "license": "MIT",
  "devDependencies": {
    "@types/greasemonkey": "4.0.7",
    "@types/node": "18.18.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/ui": "^2.1.8",
    "naive-ui": "^2.44.1",
    "sass": "1.89.0",
    "typescript": "5.6.3",
    "vfonts": "^0.0.3",
    "vite": "^7.3.1",
    "vite-plugin-monkey": "^7.1.9",
    "vitest": "^2.1.8",
    "vue-tsc": "2.2.10"
  },
  "dependencies": {
    "@vueuse/core": "13.2.0",
